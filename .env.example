# Транстелематика — task management system
# Copy this file to .env and override any value if you need to.
# All values are optional — defaults work for a typical dev machine.

# --- Host ports ---
# Override these if you already have something on the default port.
# Container ports stay the same; only the host-side binding changes.
TTM_WEB_PORT=80          # frontend (nginx) → http://localhost:${TTM_WEB_PORT}
TTM_API_PORT=8080        # backend (FastAPI) → http://localhost:${TTM_API_PORT}
TTM_DB_PORT=5433         # postgres → localhost:${TTM_DB_PORT} (only needed if you want to connect directly)
TTM_OLLAMA_PORT=11434    # ollama (only when --profile ai is used)

# --- Auth ---
# Generate a real one for prod: `openssl rand -hex 32`
JWT_SECRET=change-me-in-prod-please-32-chars-min

# --- AI (only used when `docker compose --profile ai up -d`) ---
OLLAMA_MODEL=qwen2.5:7b  # other options: qwen2.5:3b (lighter), llama3.1:8b, gemma2:9b
