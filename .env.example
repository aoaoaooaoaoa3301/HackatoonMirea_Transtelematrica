# Транстелематика — task management system
# Copy this file to .env and override any value if you need to.
# All values are optional — defaults work for a typical dev machine.

# --- Host ports ---
# Override these if you already have something on the default port.
# Container ports stay the same; only the host-side binding changes.
TTM_WEB_PORT=80          # frontend (nginx) → http://localhost:${TTM_WEB_PORT}
TTM_API_PORT=8080        # backend (FastAPI) → http://localhost:${TTM_API_PORT}
TTM_DB_PORT=5433         # postgres → localhost:${TTM_DB_PORT} (only needed if you want to connect directly)
TTM_OLLAMA_PORT=11434    # ollama (only when --profile ai is used)

# --- Auth ---
# Generate a real one for prod: `openssl rand -hex 32`
JWT_SECRET=change-me-in-prod-please-32-chars-min

# --- AI ---
OLLAMA_MODEL=ai/gemma4:E4B
LLM_PROVIDER=docker_model  # docker_model | ollama | openai_compatible | none
DOCKER_MODEL_URL=http://model-runner.docker.internal

# OpenAI-compatible provider / OpenRouter
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=qwen/qwen-2.5-7b-instruct
OPENAI_COMPATIBLE_TIMEOUT=60
OPENAI_COMPATIBLE_REFERER=http://localhost
OPENAI_COMPATIBLE_APP_TITLE=TTM Task Assistant
OPENAI_COMPATIBLE_PROVIDER_ORDER=

# Telegram bot (used with `docker compose --profile telegram up -d --build`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_INTERNAL_TOKEN=change-me
# Bot @username without @ — enables QR / deep-link auth (t.me/<username>?start=CODE)
TELEGRAM_BOT_USERNAME=
# Public URL of the web app — used to make task links in Telegram clickable
APP_PUBLIC_URL=http://localhost
